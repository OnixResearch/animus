    "ambient-executable-or-provider-discovery",
    "episode-concurrency-overflow",
    "agent-concurrency-overflow",
    "cancellation-race",
    "deadline-race",
    "public-bind",
    "wildcard-network",
    "shared-model-state-capability",
    "dispatch-before-durable-acceptance",
    "early-terminal-event",
    "content-only-retry",
    "streaming-retry-coalescing",
    "response-or-tool-result-rewrite",
    "late-write-after-seal",
    "shared-verifier-promotion",
    "artifact-link-planting",
    "artifact-collision-or-widening",
    "hidden-test-exposure",
    "partial-atomic-replacement",
    "malformed-or-stale-resume",
    "unsafe-storage-path",
    "failed-post-terminal-cleanup",
    "raw-task-or-transcript-content",
    "reasoning-or-provider-body",
    "credential-environment-or-path",
    "durability-or-exactly-once-overclaim",
    "verifier-benchmark-completion-release-overclaim",
