let InventoryRecord = {
  export_path | String,
  owning_crate | String,
  source | String,
  class | String,
  side_effect | String,
  stability | String,
  review_note | String,
  feature_gate | String,
  required_authority | String,
  depends_on | Array String,
  composes_with | Array String,
  capability_family | String,
}
in
let default_feature = "compat" in
let default_family = "compatibility" in
let comma = "," in
let entry = fun export_path_value owning_crate_value source_value class_value side_effect_value stability_value review_note_value =>
  {
    export_path = export_path_value,
    owning_crate = owning_crate_value,
    source = source_value,
    class = class_value,
    side_effect = side_effect_value,
    stability = stability_value,
    review_note = review_note_value,
    feature_gate = default_feature,
    required_authority = side_effect_value,
    depends_on = [],
    composes_with = [],
    capability_family = default_family,
  }
in
let line = fun record => "entry|%{record.export_path}|%{record.owning_crate}|%{record.source}|%{record.class}|%{record.side_effect}|%{record.stability}|%{record.review_note}|%{record.feature_gate}|%{record.required_authority}|%{std.string.join comma record.depends_on}|%{std.string.join comma record.composes_with}|%{record.capability_family}"
in
