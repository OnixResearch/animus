let Profile = {
  id | String,
  description | String,
  scope | String,
  posture | String,
  rule_ids | Array String,
  non_claims | Array String,
} in
let Rule = {
  id | String,
  category | String,
  severity | String,
  language | String,
  fixture_positive | String,
  fixture_negative | String,
} in
let profiles | Array Profile = [
  {
    id = "core",
    description = "no-std reusable core DTO and reducer surfaces",
    scope = "crates/animus-core/src/**/*.rs",
    posture = "inventory-only",
    rule_ids = ["ambient-filesystem-call", "ambient-process-command", "unsafe-block", "panic-macro", "direct-provider-client"],
    non_claims = ["not-a-safety-proof", "not-release-readiness"],
  },
  {
    id = "adapter-dto",
    description = "adapter DTO, admission, and receipt surfaces",
    scope = "crates/animus-adapters/src/**/*.rs",
    posture = "inventory-only",
    rule_ids = ["ambient-filesystem-call", "ambient-process-command", "unsafe-block", "panic-macro", "direct-provider-client"],
    non_claims = ["not-adapter-correctness", "not-provider-behavior"],
  },
  {
    id = "runtime",
    description = "runtime orchestration and feature-pack boundaries",
    scope = "crates/animus-runtime/src/**/*.rs",
    posture = "inventory-only",
    rule_ids = ["ambient-filesystem-call", "ambient-process-command", "unsafe-block", "panic-macro", "direct-provider-client"],
    non_claims = ["not-runtime-safety", "not-provider-behavior"],
  },
  {
    id = "std-shell",
    description = "host-owned std shell surfaces where effects may be planned or executed by injected services",
    scope = "crates/animus-std/src/**/*.rs",
    posture = "inventory-only",
    rule_ids = ["unsafe-block", "panic-macro", "direct-provider-client"],
    non_claims = ["not-shell-correctness", "not-release-readiness"],
  },
  {
    id = "steel-loop-fabric",
    description = "Steel loop fabric adapters and policies",
    scope = "crates/animus-steel/src/**/*.rs",
    posture = "inventory-only",
    rule_ids = ["ambient-filesystem-call", "ambient-process-command", "unsafe-block", "panic-macro"],
    non_claims = ["not-steel-policy-enforcement", "not-runtime-safety"],
  },
  {
    id = "tui-host",
    description = "terminal host surfaces and UI adapters",
    scope = "crates/animus-tui/src/**/*.rs",
    posture = "inventory-only",
    rule_ids = ["unsafe-block", "panic-macro", "direct-provider-client"],
    non_claims = ["not-terminal-safety", "not-provider-behavior"],
  },
  {
    id = "generated-config",
    description = "generated configuration projections and checker inputs",
    scope = "docs/**/*.md cairn/**/*.ncl",
    posture = "inventory-only",
    rule_ids = [],
    non_claims = ["not-config-correctness", "not-release-readiness"],
  },
] in
let docs_lines = [
  "# ast-grep Agent Boundary Audits",
  "",
  "Animus uses ast-grep as an inventory-only structural audit rail for syntax shapes that can threaten reusable agent boundaries. These scans are candidate review evidence, not proof of harness safety, adapter correctness, provider behavior, Steel policy enforcement, or release readiness.",
  "",
  "## Profiles",
  "",
  "| Profile | Scope | Posture | Non-claims |",
  "|---|---|---|---|",
  "| core | `crates/animus-core/src/**/*.rs` | inventory-only | not-a-safety-proof, not-release-readiness |",
  "| adapter-dto | `crates/animus-adapters/src/**/*.rs` | inventory-only | not-adapter-correctness, not-provider-behavior |",
  "| runtime | `crates/animus-runtime/src/**/*.rs` | inventory-only | not-runtime-safety, not-provider-behavior |",
  "| std-shell | `crates/animus-std/src/**/*.rs` | inventory-only | not-shell-correctness, not-release-readiness |",
  "| steel-loop-fabric | `crates/animus-steel/src/**/*.rs` | inventory-only | not-steel-policy-enforcement, not-runtime-safety |",
  "| tui-host | `crates/animus-tui/src/**/*.rs` | inventory-only | not-terminal-safety, not-provider-behavior |",
  "| generated-config | `docs/**/*.md cairn/**/*.ncl` | inventory-only | not-config-correctness, not-release-readiness |",
  "",
  "## Inventory rules",
  "",
  "| Rule | Category | Severity | Promotion guard |",
  "|---|---|---|---|",
  "| ambient-filesystem-call | ambient-authority | hint | positive and negative fixtures must pass before warning/blocking posture |",
  "| ambient-process-command | ambient-authority | hint | positive and negative fixtures must pass before warning/blocking posture |",
  "| unsafe-block | unsafe-code | hint | positive and negative fixtures must pass before warning/blocking posture |",
  "| panic-macro | panic-path | hint | positive and negative fixtures must pass before warning/blocking posture |",
  "| direct-provider-client | provider-boundary | hint | positive and negative fixtures must pass before warning/blocking posture |",
  "",
  "## Receipt identity",
  "",
  "`check-ast-grep-agent-boundary-audits` captures ast-grep version, BLAKE3 rule-bundle identity, scan scopes, bounded finding counts, fixture outcomes, and non-claim labels. Receipts intentionally omit raw source payloads, provider payloads, credentials, private paths, and unbounded output.",
  "",
  "## Validation",
  "",
  "Run:",
  "",
  "```sh",
  "scripts/cairn/check-ast-grep-agent-boundary-audits --root .",
  "nix build .#checks.x86_64-linux.ast-grep-agent-boundary-audits --no-link -L",
  "```",
  "",
  "The rail validates Nickel profile/doc drift, ast-grep rule fixtures, BLAKE3 bundle identity, safe receipt fields, and inventory scan execution.",
] in
let rules | Array Rule = [
  {
    id = "ambient-filesystem-call",
    category = "ambient-authority",
    severity = "hint",
    language = "Rust",
    fixture_positive = "cairn/ast-grep-agent-boundary-fixtures/positive-boundary-violations.rs",
    fixture_negative = "cairn/ast-grep-agent-boundary-fixtures/negative-host-shell-allowed.rs",
  },
  {
    id = "ambient-process-command",
    category = "ambient-authority",
    severity = "hint",
    language = "Rust",
    fixture_positive = "cairn/ast-grep-agent-boundary-fixtures/positive-boundary-violations.rs",
    fixture_negative = "cairn/ast-grep-agent-boundary-fixtures/negative-host-shell-allowed.rs",
  },
  {
    id = "unsafe-block",
    category = "unsafe-code",
    severity = "hint",
    language = "Rust",
    fixture_positive = "cairn/ast-grep-agent-boundary-fixtures/positive-boundary-violations.rs",
    fixture_negative = "cairn/ast-grep-agent-boundary-fixtures/negative-pure-reducer.rs",
  },
  {
    id = "panic-macro",
    category = "panic-path",
    severity = "hint",
    language = "Rust",
    fixture_positive = "cairn/ast-grep-agent-boundary-fixtures/positive-boundary-violations.rs",
    fixture_negative = "cairn/ast-grep-agent-boundary-fixtures/negative-pure-reducer.rs",
  },
  {
    id = "direct-provider-client",
    category = "provider-boundary",
    severity = "hint",
    language = "Rust",
    fixture_positive = "cairn/ast-grep-agent-boundary-fixtures/positive-boundary-violations.rs",
    fixture_negative = "cairn/ast-grep-agent-boundary-fixtures/negative-injected-provider.rs",
  },
] in
{
  profiles,
  rules,
  receipt_schema = {
    tool = "ast-grep",
    tool_version = "captured-by-check-rail",
    rule_bundle_identity = "BLAKE3 over cairn/ast-grep-agent-boundary-rules/*.yml",
    scan_scope = "profile scope plus fixture scan path",
    findings_summary = "counts only; no raw source payloads",
    non_claim_labels = [
      "not-a-safety-proof",
      "not-adapter-correctness",
      "not-runtime-safety",
      "not-provider-behavior",
      "not-steel-policy-enforcement",
      "not-release-readiness",
    ],
  },
  docs_markdown = std.string.join "\n" docs_lines,
}
