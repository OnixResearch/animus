#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly RAIL_NAME=provenance-git-ai
readonly RECEIPT_SCHEMA=animus.focused-rail.v1
readonly RECEIPT_DIR=target/cairn/focused-rails
readonly LOCAL_TMP_DIR=target/tmp
readonly POLICY_SOURCE=policy/provenance/policy.ncl
readonly POLICY_FIELD=provenance_policy
readonly INVALID_FIELD=invalid_type_fixture
readonly GENERATED_POLICY=policy/provenance/generated/provenance-policy.json
readonly DOC_PATH=docs/provenance-git-ai.md
readonly RUNTIME_PATH=crates/animus-runtime/src/provenance/gitai.rs
readonly TEST_PATH=crates/animus-runtime/src/provenancetests/gitai.rs

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

if ! command -v cargo >/dev/null 2>&1; then
  printf '%s\n' 'error: cargo is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

if ! command -v nickel >/dev/null 2>&1; then
  printf '%s\n' 'error: nickel is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

require_contains() {
  file=$1
  needle=$2
  if ! grep -F -- "${needle}" "${file}" >/dev/null 2>&1; then
    printf 'error: %s missing marker: %s\n' "${file}" "${needle}" >&2
    exit "${FAILURE}"
  fi
}

cd "${repo_root}"

mkdir -p "${LOCAL_TMP_DIR}"
tmp_dir=$(mktemp -d "${LOCAL_TMP_DIR}/animus-provenance-git-ai.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM

nickel export --format json --field "${POLICY_FIELD}" "${POLICY_SOURCE}" > "${tmp_dir}/provenance-policy.json"
diff -u "${GENERATED_POLICY}" "${tmp_dir}/provenance-policy.json"

if nickel export --format json --field "${INVALID_FIELD}" "${POLICY_SOURCE}" > "${tmp_dir}/invalid.json" 2> "${tmp_dir}/invalid.err"; then
  printf '%s\n' 'error: invalid provenance policy fixture exported successfully' >&2
  exit "${FAILURE}"
fi

TMPDIR="${repo_root}/${LOCAL_TMP_DIR}" cargo test -p animus-runtime --locked provenance

require_contains "${DOC_PATH}" "Git AI as a bounded reference"
require_contains "${DOC_PATH}" "does not adopt Git AI's daemon, installer, updater, hosted telemetry, SQLite prompt store, Git operation watcher"
require_contains "${DOC_PATH}" "A non-Git backend can record provenance without Git AI IDs"
require_contains "${RUNTIME_PATH}" "VersionControlProvenanceBackend"
require_contains "${RUNTIME_PATH}" "validate_vcs_neutral_field_names"
require_contains "${TEST_PATH}" "in_memory_backend_records_checkpoints_without_git"
require_contains "${TEST_PATH}" "safe_checkpoint_receipts_reject_leak_fixtures"

mkdir -p "${RECEIPT_DIR}"
receipt_path=${RECEIPT_DIR}/${RAIL_NAME}.md
cat > "${receipt_path}" <<EOF
schema: ${RECEIPT_SCHEMA}
rail: ${RAIL_NAME}
status: pass
boundary: VCS-neutral Git AI-inspired provenance checkpointing and optional compatibility adapter
policy_source: ${POLICY_SOURCE}
policy_export: checked
invalid_type_fixture: rejected
positive_fixtures:
- VCS-neutral content observations validate without a VCS backend
- in-memory non-Git backend records before/after mutating-tool checkpoints
- pure line-range compression, removal, hunk shifting, and accepted-line counts are deterministic
- Git AI v3 compatibility DTO validates authorship/3.0.0 at the optional adapter boundary
negative_fixtures:
- Git terms in reusable DTO fields, missing required backends, unknown mutation kinds, unsupported backend requirements, unsafe receipt redaction, malformed ranges/hunks, malformed external compatibility IDs, and receipt leak attempts fail closed
safe_evidence:
- receipts contain status, backend kind, mutation kind, bounded counts, session/trace IDs, BLAKE3 content hashes, and redaction markers only
- no raw prompts, provider payloads, credentials, full paths, raw tool bodies, raw model output, raw diffs, unbounded output, Git notes, or Git AI external IDs are required by non-Git backends
non_claims:
- this rail does not adopt Git AI daemon, installer, updater, hosted telemetry, SQLite prompt store, Git operation watcher, Git-only workflow assumptions, Git as required VCS, live Git notes persistence, provider behavior, TUI behavior, or production readiness
EOF

printf 'focused rail %s: pass\n' "${RAIL_NAME}"
printf 'receipt: %s\n' "${receipt_path}"
