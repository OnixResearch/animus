#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly ROOT_FLAG=--root
readonly DEFAULT_ROOT=.
readonly RECEIPT=target/cairn/focused-rails/basalt-authority-adapter.md
readonly BASALT_REVISION=3f1fd1ed63f2b55f07a27f662e5a720518662b7e
readonly UCAN_REVISION=927dc32641af6cd1b17202aff44c35acef4540fa
readonly POLICY_IDENTITY=b3:5475d5473ec98cbf052a83512836b0739f5dad3e7b9b0ed201eb3094b1cf39bf
readonly EXECUTION_POLICY_IDENTITY=b3:c90838cfc1f3c8f5f926f9ee98a05d203d2c0dc2199657514537c37bff3d8c7d
readonly UCAN_CATALOG_IDENTITY=b3:fe77fd63076eaef555b74e702e4c14e483bdba70151ccc955c75b17d97412427

root=${DEFAULT_ROOT}
if [ "${1:-}" = "${ROOT_FLAG}" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  root=$2
fi
cd "${root}"

for marker in "${BASALT_REVISION}" "${UCAN_REVISION}" "${POLICY_IDENTITY}" "${EXECUTION_POLICY_IDENTITY}" "${UCAN_CATALOG_IDENTITY}" 'AGPL-3.0-or-later'; do
  if ! grep -Fq "${marker}" crates/animus-std-basalt-authority/src/core.rs config/basalt-authority-adapter.ncl docs/basalt-authority-adapter.md; then
    printf 'error: Basalt cohort marker is missing: %s\n' "${marker}" >&2
    exit "${FAILURE}"
  fi
done

if [ "${ANIMUS_BASALT_SKIP_NICKEL:-0}" != "1" ]; then
  scripts/config/check-nickel-configs
fi
nickel export --format json fixtures/basalt-authority/positive.ncl >/dev/null
nickel export --format json fixtures/basalt-authority/negative.ncl >/dev/null

cargo test -p animus-adapters host_authority --locked
cargo test -p animus-std-basalt-authority --locked
cargo clippy -p animus-std-basalt-authority --all-targets -- -D warnings
cargo check -p animus-adapters --no-default-features --locked
cargo check -p animus-adapters --target wasm32-unknown-unknown --no-default-features --locked
cargo check -p animus --no-default-features --locked
cargo check -p animus --no-default-features --features basalt-authority-adapter --locked

if cargo tree -p animus --edges normal --format '{lib}' | grep -Eiq '(^|[-_])(basalt|ucan)([-_]|$)'; then
  printf '%s\n' 'error: Basalt or UCAN leaked into the default root facade' >&2
  exit "${FAILURE}"
fi
if grep -Eq 'basalt::|ucan::' crates/animus-adapters/src/effect/gate.rs crates/animus-adapters/src/effect/gate/*.rs; then
  printf '%s\n' 'error: concrete Basalt or UCAN type leaked into the generic authority contracts' >&2
  exit "${FAILURE}"
fi

if [ "${ANIMUS_BASALT_SKIP_CONNECTED:-0}" != "1" ]; then
  sh scripts/cairn/check-clash-ucan-authority --root .
  sh scripts/cairn/check-coding-session-host --root .
  sh scripts/cairn/check-runtime-authority-seal --root .
fi
sh scripts/cairn/check-component-catalog
sh scripts/cairn/check-runtime-facade-inventory
sh scripts/cairn/check-evidence-safety --root .

mkdir -p "$(dirname "${RECEIPT}")"
cat > "${RECEIPT}" <<EOF
schema: animus.focused-rail.v1
rail: basalt-authority-adapter
status: pass
cohort:
- basalt_revision: ${BASALT_REVISION}
- vendored_ucan_revision: ${UCAN_REVISION}
- basalt_policy_identity: ${POLICY_IDENTITY}
- ucan_catalog_identity: ${UCAN_CATALOG_IDENTITY}
- license: AGPL-3.0-or-later
coverage:
- implementation-neutral no-std provider contracts
- exact agent-definition identity to audience DID binding
- closed document read, document write, and process execute action mappings
- per-purpose reviewed policy identity selection with explicit execution policy
- direct and delegated raw holder invocation verification
- token, holder, proof, revocation, caveat, scope, policy, digest, replay, and stale-input denial
- final replay admission after all other verification inputs
- intersection with every existing Animus gate
- durable safe-decision commit before guarded effect
- metadata-only allow and denial receipts
- default, no-default, Wasm, catalog, facade, and evidence isolation
non_claims:
- no global trust, key truth, global revocation freshness, replay durability, sandbox confinement, effect correctness, agent safety, completion, production readiness, or release eligibility is established
- execution-purpose admission binds only the supplied context reference; it does not authenticate the context preimage, executable, argv, environment, inputs, or custody
- no license compatibility exception is granted
EOF

printf '%s\n' 'focused rail basalt-authority-adapter: pass'
printf 'receipt: %s\n' "${RECEIPT}"
