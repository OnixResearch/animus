#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly SUCCESS=0
readonly PROMPT='bounded prompt fixture'
readonly TOOL_LABEL='fake-readonly-tool'
readonly HEADER='ANIMUS_DOGFOOD_SMOKE'
readonly PACKAGED_RUNG='packaged_rung=packaged-headless-smoke'
readonly CORE_RUNG='core_rung=fake-backed-integration'
readonly TOOL_EVENT='kind=tool-admission'
readonly LIVE_PROVIDER_NON_CLAIM='surface=live-provider'
readonly PRODUCTION_NON_CLAIM='surface=production-readiness'
readonly MISSING_PROMPT='missing-prompt'
readonly MISSING_MODEL='missing-model-service'
readonly DENIED_CAPABILITY='denied-capability'
readonly MALFORMED_OUTPUT='malformed-output'
readonly UNSAFE_EVIDENCE='unsafe-evidence'

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

cd "${repo_root}"

run_smoke() {
  cargo run -q -p animus-std --features dogfood-smoke --bin animus-dogfood-smoke --locked -- "$@"
}

require_contains() {
  haystack=$1
  needle=$2
  label=$3
  case "${haystack}" in
    *"${needle}"*) ;;
    *)
      printf 'error: missing %s marker: %s\n' "${label}" "${needle}" >&2
      exit "${FAILURE}"
      ;;
  esac
}

require_omits() {
  haystack=$1
  needle=$2
  label=$3
  case "${haystack}" in
    *"${needle}"*)
      printf 'error: unsafe %s marker leaked: %s\n' "${label}" "${needle}" >&2
      exit "${FAILURE}"
      ;;
    *) ;;
  esac
}

expect_failure() {
  expected=$1
  shift
  output=$(run_smoke "$@" 2>&1) && {
    printf 'error: command unexpectedly passed for %s\n%s\n' "${expected}" "${output}" >&2
    exit "${FAILURE}"
  }
  require_contains "${output}" "${expected}" "negative-fixture"
}

cargo test -q -p animus-std --features dogfood-smoke packaged_smoke --locked

positive_output=$(run_smoke --prompt "${PROMPT}" --tool "${TOOL_LABEL}")
require_contains "${positive_output}" "${HEADER}" 'header'
require_contains "${positive_output}" "${PACKAGED_RUNG}" 'packaged-rung'
require_contains "${positive_output}" "${CORE_RUNG}" 'core-rung'
require_contains "${positive_output}" "${TOOL_EVENT}" 'tool-event'
require_contains "${positive_output}" "${LIVE_PROVIDER_NON_CLAIM}" 'live-provider-non-claim'
require_contains "${positive_output}" "${PRODUCTION_NON_CLAIM}" 'production-non-claim'
require_omits "${positive_output}" "${PROMPT}" 'raw-prompt'
require_omits "${positive_output}" 'RAW_PROMPT' 'raw-prompt-label'

expect_failure "${MISSING_PROMPT}"
expect_failure "${MISSING_MODEL}" --prompt "${PROMPT}" --missing-model-service
expect_failure "${DENIED_CAPABILITY}" --prompt "${PROMPT}" --deny-capability
expect_failure "${MALFORMED_OUTPUT}" --prompt "${PROMPT}" --malformed-model-output
expect_failure "${UNSAFE_EVIDENCE}" --prompt "${PROMPT}" --policy 'RAW_PROMPT:secret'

printf '%s\n' 'packaged headless dogfood smoke rail: ok'
exit "${SUCCESS}"
