#!/usr/bin/env sh
set -eu

readonly FAILURE=1

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

rust_source=${script_dir}/check-preserves-boundary-schemas.rs
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-preserves-boundaries.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM
checker=${tmp_dir}/check-preserves-boundary-schemas

rustc --edition=2021 "${rust_source}" -o "${checker}"
"${checker}" --self-test
"${checker}" --root "${repo_root}"
