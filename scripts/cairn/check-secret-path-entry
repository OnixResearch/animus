#!/usr/bin/env sh
set -eu
root='.'
if [ "${1:-}" = '--root' ]; then root=${2:-.}; fi
cd "$root"
for tool in cargo b3sum grep; do command -v "$tool" >/dev/null 2>&1 || exit 1; done
cargo test -p animus-std-secretspec --test interactive --locked
cargo clippy -p animus-std-secretspec --all-targets --locked -- -D warnings
grep -F 'returns only the path' docs/secretspec-host-resolution.md >/dev/null
grep -F 'MaskedSecretInput' crates/animus-std-secretspec/src/interactive.rs >/dev/null
mkdir -p target/cairn/focused-rails
cat > target/cairn/focused-rails/secret-path-entry.md <<EOF
schema: animus.focused-rail-receipt.v1
rail: secret-path-entry
status: pass
source_blake3: $(b3sum crates/animus-std-secretspec/src/interactive.rs | cut -d ' ' -f 1)
claims: masked-input,path-only-result,owner-only-file,tracked-cleanup,interactive-authority
non_claims: host-user-isolation,process-sandboxing,secure-erasure,credential-validity
EOF
printf '%s\n' 'focused rail secret-path-entry: pass'
