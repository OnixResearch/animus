#!/usr/bin/env sh
set -eu
readonly FAILURE=1
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v rustc >/dev/null 2>&1 || { printf '%s\n' 'error: rustc is required' >&2; exit "${FAILURE}"; }
command -v nickel >/dev/null 2>&1 || { printf '%s\n' 'error: nickel is required' >&2; exit "${FAILURE}"; }
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-schedule-reliability.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM
rustc --edition=2021 "${script_dir}/check-schedule-reliability.rs" -o "${tmp_dir}/check"
"${tmp_dir}/check" "$@"
root='.'
if [ "${1:-}" = '--root' ]; then root=${2:-.}; fi
cd "${root}"
exported=$(mktemp)
trap 'rm -f "${exported}"; rm -rf "${tmp_dir}"' EXIT HUP INT TERM
nickel export --format json --field schedule_reliability_policy config/schedule-reliability-policy.ncl > "${exported}"
diff -u config/generated/schedule-reliability-policy.json "${exported}"
cargo test -p animus-runtime --features schedule-reliability schedule_reliability --locked
cargo check -p animus-runtime --no-default-features --features schedule-reliability --locked
cargo check -p animus-runtime --features schedule-reliability --target wasm32-unknown-unknown --locked
cargo check -p animus --features schedule-reliability --locked
printf '%s\n' 'focused rail schedule-reliability: pass'
