#!/usr/bin/env sh
# r[agent_harness_runtime.session_core_crate.catalog]
set -eu

readonly FAILURE=1
readonly CATALOG_RELATIVE_PATH=.cairn/component-catalog.ncl
readonly DOCS_RELATIVE_PATH=docs/component-catalog.md
readonly FIXTURE_DIR=.cairn/component-catalog-fixtures
readonly COMPONENT_LINES_FIELD=component_lines
readonly DOCS_FIELD=docs_markdown
readonly EXPECTED_FIELD=expected_issue
readonly EXPECTED_OK=OK

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

if ! command -v nickel >/dev/null 2>&1; then
  printf '%s\n' 'error: nickel is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

rust_source=${script_dir}/check-component-catalog.rs
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-component-catalog.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM

checker=${tmp_dir}/check-component-catalog
rustc --edition=2021 "${rust_source}" -o "${checker}"

catalog_source=${repo_root}/${CATALOG_RELATIVE_PATH}
catalog_lines=${tmp_dir}/component-catalog.lines
nickel export --format raw --field "${COMPONENT_LINES_FIELD}" "${catalog_source}" > "${catalog_lines}"

if command -v b3sum >/dev/null 2>&1; then
  printf 'component_catalog_b3=%s\n' "$(b3sum "${catalog_lines}" | awk '{print $1}')"
else
  printf '%s\n' 'component_catalog_b3=unavailable:b3sum-not-on-path'
fi

"${checker}" --root "${repo_root}" --catalog "${catalog_lines}" --docs "${repo_root}/${DOCS_RELATIVE_PATH}"

if [ -d "${repo_root}/${FIXTURE_DIR}" ]; then
  for fixture in "${repo_root}/${FIXTURE_DIR}"/*.ncl; do
    if [ ! -e "${fixture}" ]; then
      continue
    fi
    fixture_name=$(basename "${fixture}" .ncl)
    fixture_catalog=${tmp_dir}/${fixture_name}.catalog.lines
    fixture_docs=${tmp_dir}/${fixture_name}.docs.md
    fixture_output=${tmp_dir}/${fixture_name}.out
    expected_issue=$(nickel export --format raw --field "${EXPECTED_FIELD}" "${fixture}")
    nickel export --format raw --field "${COMPONENT_LINES_FIELD}" "${fixture}" > "${fixture_catalog}"
    nickel export --format raw --field "${DOCS_FIELD}" "${fixture}" > "${fixture_docs}"

    if [ -s "${fixture_docs}" ]; then
      docs_args="--docs ${fixture_docs}"
    else
      docs_args=""
    fi

    if [ "${expected_issue}" = "${EXPECTED_OK}" ]; then
      # shellcheck disable=SC2086
      "${checker}" --root "${repo_root}" --catalog "${fixture_catalog}" ${docs_args} > "${fixture_output}" 2>&1
      printf 'positive fixture ok: %s\n' "${fixture_name}"
      continue
    fi

    # shellcheck disable=SC2086
    if "${checker}" --root "${repo_root}" --catalog "${fixture_catalog}" ${docs_args} > "${fixture_output}" 2>&1; then
      printf 'error: fixture %s unexpectedly passed\n' "${fixture_name}" >&2
      cat "${fixture_output}" >&2
      exit "${FAILURE}"
    fi
    if ! grep -F "ERROR ${expected_issue}" "${fixture_output}" >/dev/null 2>&1; then
      printf 'error: fixture %s did not report expected issue %s\n' "${fixture_name}" "${expected_issue}" >&2
      cat "${fixture_output}" >&2
      exit "${FAILURE}"
    fi
    printf 'negative fixture ok: %s -> %s\n' "${fixture_name}" "${expected_issue}"
  done
fi
