#!/usr/bin/env sh
set -eu
readonly FAILURE=1
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v rustc >/dev/null 2>&1 || { printf '%s\n' 'error: rustc is required' >&2; exit "${FAILURE}"; }
command -v nickel >/dev/null 2>&1 || { printf '%s\n' 'error: nickel is required' >&2; exit "${FAILURE}"; }
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-provider-video-payloads.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM
rustc --edition=2021 "${script_dir}/check-provider-video-payloads.rs" -o "${tmp_dir}/check"
rustc --edition=2021 --test "${script_dir}/check-provider-video-payloads.rs" -o "${tmp_dir}/check-tests"
"${tmp_dir}/check-tests"
"${tmp_dir}/check" "$@"
root='.'
if [ "${1:-}" = '--root' ]; then root=${2:-.}; fi
cd "${root}"
exported="${tmp_dir}/provider-video-payload-policy.json"
nickel export --format json --field provider_video_payload_policy config/provider-video-payload-policy.ncl > "${exported}"
diff -u config/generated/provider-video-payload-policy.json "${exported}"
nickel typecheck fixtures/provider-video-payload/positive.ncl
nickel typecheck fixtures/provider-video-payload/negative.ncl
nickel typecheck fixtures/provider-video-payload/google-gemini-v1beta-files.ncl
cargo test -p animus-adapters multimodal --locked
cargo clippy -p animus-adapters --all-targets --locked -- -D warnings
cargo check -p animus-adapters --no-default-features --locked
cargo check -p animus-adapters --target wasm32-unknown-unknown --locked
printf '%s\n' 'focused rail provider-video-payloads: pass'
