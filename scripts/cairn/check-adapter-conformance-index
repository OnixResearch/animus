#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly MANIFEST_RELATIVE_PATH=cairn/adapter-conformance-index.ncl
readonly CONTRACTS_INDEX_RELATIVE_PATH=docs/contracts-index.md
readonly FIXTURE_DIR=cairn/adapter-conformance-index-fixtures
readonly FAMILY_FIELD=family_lines
readonly CASE_FIELD=case_lines
readonly EXPECTED_FIELD=expected_issue
readonly EXPECTED_OK=OK

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

if ! command -v nickel >/dev/null 2>&1; then
  printf '%s\n' 'error: nickel is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

rust_source=${script_dir}/check-adapter-conformance-index.rs
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-adapter-conformance-index.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM

checker=${tmp_dir}/check-adapter-conformance-index
rustc --edition=2021 "${rust_source}" -o "${checker}"

manifest_source=${repo_root}/${MANIFEST_RELATIVE_PATH}
family_lines=${tmp_dir}/families.lines
case_lines=${tmp_dir}/cases.lines
nickel export --format raw --field "${FAMILY_FIELD}" "${manifest_source}" > "${family_lines}"
nickel export --format raw --field "${CASE_FIELD}" "${manifest_source}" > "${case_lines}"

if command -v b3sum >/dev/null 2>&1; then
  printf 'adapter_conformance_family_b3=%s\n' "$(b3sum "${family_lines}" | awk '{print $1}')"
  printf 'adapter_conformance_case_b3=%s\n' "$(b3sum "${case_lines}" | awk '{print $1}')"
else
  printf '%s\n' 'adapter_conformance_family_b3=unavailable:b3sum-not-on-path'
  printf '%s\n' 'adapter_conformance_case_b3=unavailable:b3sum-not-on-path'
fi

"${checker}" \
  --root "${repo_root}" \
  --families "${family_lines}" \
  --cases "${case_lines}" \
  --docs "${repo_root}/${CONTRACTS_INDEX_RELATIVE_PATH}"

if [ -d "${repo_root}/${FIXTURE_DIR}" ]; then
  for fixture in "${repo_root}/${FIXTURE_DIR}"/*.ncl; do
    if [ ! -e "${fixture}" ]; then
      continue
    fi
    fixture_name=$(basename "${fixture}" .ncl)
    fixture_families=${tmp_dir}/${fixture_name}.families.lines
    fixture_cases=${tmp_dir}/${fixture_name}.cases.lines
    fixture_output=${tmp_dir}/${fixture_name}.out
    expected_issue=$(nickel export --format raw --field "${EXPECTED_FIELD}" "${fixture}")
    nickel export --format raw --field "${FAMILY_FIELD}" "${fixture}" > "${fixture_families}"
    nickel export --format raw --field "${CASE_FIELD}" "${fixture}" > "${fixture_cases}"

    if [ "${expected_issue}" = "${EXPECTED_OK}" ]; then
      "${checker}" --root "${repo_root}" --families "${fixture_families}" --cases "${fixture_cases}" > "${fixture_output}" 2>&1
      printf 'positive fixture ok: %s\n' "${fixture_name}"
      continue
    fi

    if "${checker}" --root "${repo_root}" --families "${fixture_families}" --cases "${fixture_cases}" > "${fixture_output}" 2>&1; then
      printf 'error: fixture %s unexpectedly passed\n' "${fixture_name}" >&2
      cat "${fixture_output}" >&2
      exit "${FAILURE}"
    fi
    if ! grep -F "ERROR ${expected_issue}" "${fixture_output}" >/dev/null 2>&1; then
      printf 'error: fixture %s did not report expected issue %s\n' "${fixture_name}" "${expected_issue}" >&2
      cat "${fixture_output}" >&2
      exit "${FAILURE}"
    fi
    printf 'negative fixture ok: %s -> %s\n' "${fixture_name}" "${expected_issue}"
  done
fi
