#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly RAIL_NAME=ratatui-tool-host-surface
readonly RECEIPT_SCHEMA=animus.focused-rail.v1
readonly RECEIPT_DIR=target/cairn/focused-rails

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-ratatui-tool-host.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM

rust_source=${script_dir}/check-ratatui-tool-host-surface.rs
checker=${tmp_dir}/check-ratatui-tool-host-surface
rustc --edition=2021 "${rust_source}" -o "${checker}"
"${checker}" --root "${repo_root}"

mkdir -p "${repo_root}/${RECEIPT_DIR}"
receipt_path=${repo_root}/${RECEIPT_DIR}/${RAIL_NAME}.md
cat > "${receipt_path}" <<EOF
schema: ${RECEIPT_SCHEMA}
rail: ${RAIL_NAME}
status: pass
boundary: optional TUI host surface with UI-neutral tool bridge and pure render reducer
positive_fixtures:
- animus-tui owns the SSH-pinned Rats dependency and exposes bridge/render APIs
- animus-tui tests cover lifecycle events, simple adapter compatibility, progress rendering, and runtime-event snapshots
negative_fixtures:
- reusable crate manifests and public lib exports are checked for Rats/Ratatui/Crossterm leakage
- guarded-tool denial, mismatched correlation IDs, dropped event consumers, closed command channels, invalid DTOs, and runtime denial fail closed in tests
non_claims:
- this rail does not dogfood a live terminal, start a daemon, exercise real raw-mode setup, or claim production TUI readiness
EOF

printf 'focused rail %s: pass\n' "${RAIL_NAME}"
printf 'receipt: %s\n' "${receipt_path}"
