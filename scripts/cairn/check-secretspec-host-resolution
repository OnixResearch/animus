#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly ROOT_FLAG=--root
readonly DEFAULT_ROOT=.
readonly RECEIPT=target/cairn/focused-rails/secretspec-host-resolution.md
readonly SECRETSPEC_VERSION=0.17.0
readonly SECRETSPEC_COMMIT=a8794e46ec9664a0e1a3869cc3105d0853937e48
readonly SECRETSPEC_CHECKSUM=68498f9695bb3662c157b8fd4b4665a594f1157de022ff5b0f891af4c7ec75d2
readonly BOUNDED_EXEC_COMMIT=29dac88ecded94457572db3fdfaaaab95fa91525
readonly SECRETSPEC_LICENSE=Apache-2.0
readonly BOUNDED_EXEC_LICENSE=AGPL-3.0-or-later

root=${DEFAULT_ROOT}
if [ "${1:-}" = "${ROOT_FLAG}" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  root=$2
fi
cd "${root}"

for marker in "${SECRETSPEC_VERSION}" "${SECRETSPEC_COMMIT}" "${SECRETSPEC_CHECKSUM}" "${BOUNDED_EXEC_COMMIT}" "${SECRETSPEC_LICENSE}" "${BOUNDED_EXEC_LICENSE}"; do
  if ! grep -Fq "${marker}" config/secret-resolution-policy.ncl crates/animus-std-secretspec/src/policy.rs docs/secretspec-host-resolution.md; then
    printf 'error: SecretSpec cohort marker is missing: %s\n' "${marker}" >&2
    exit "${FAILURE}"
  fi
done

if [ "${ANIMUS_SECRETSPEC_SKIP_NICKEL:-0}" != "1" ]; then
  scripts/config/check-nickel-configs
fi
nickel export --format json fixtures/secret-resolution/positive.ncl >/dev/null
nickel export --format json fixtures/secret-resolution/negative.ncl >/dev/null

cargo test -p animus-adapters --locked secret_resolution
cargo test -p animus-std-secretspec --locked --features test-fixtures
cargo clippy -p animus-adapters -p animus-std-secretspec --all-targets --features animus-std-secretspec/test-fixtures -- -D warnings
cargo check -p animus-adapters --no-default-features --locked
cargo check -p animus-adapters --target wasm32-unknown-unknown --no-default-features --locked
cargo check -p animus --no-default-features --locked
cargo check -p animus --no-default-features --features secretspec-host-resolution --locked

if cargo tree -p animus --edges normal --format '{lib}' | grep -Eiq '(^|[-_])(secretspec|bounded_exec)([-_]|$)'; then
  printf '%s\n' 'error: SecretSpec or bounded-exec leaked into the default facade' >&2
  exit "${FAILURE}"
fi
if grep -Eq 'bounded_exec|std::process|std::fs|std::env' crates/animus-adapters/src/secret_resolution.rs; then
  printf '%s\n' 'error: host authority leaked into the no-std credential contract' >&2
  exit "${FAILURE}"
fi
if grep -R -Eq 'derive\([^)]*(Serialize|Hash)' crates/animus-std-secretspec/src/material.rs; then
  printf '%s\n' 'error: secret material gained serialization or hashing' >&2
  exit "${FAILURE}"
fi

if [ "${ANIMUS_SECRETSPEC_SKIP_CONNECTED:-0}" != "1" ]; then
  sh scripts/cairn/check-injected-services --root .
  sh scripts/cairn/check-process-job-profiles --root .
  sh scripts/cairn/check-component-catalog
  sh scripts/cairn/check-runtime-facade-inventory
  sh scripts/cairn/check-evidence-safety --root .
fi

mkdir -p "$(dirname "${RECEIPT}")"
cat > "${RECEIPT}" <<EOF
schema: animus.focused-rail.v1
rail: secretspec-host-resolution
status: pass
cohort:
- secretspec_version: ${SECRETSPEC_VERSION}
- secretspec_commit: ${SECRETSPEC_COMMIT}
- crates_io_checksum_sha256: ${SECRETSPEC_CHECKSUM}
- secretspec_license: ${SECRETSPEC_LICENSE}
- bounded_exec_commit: ${BOUNDED_EXEC_COMMIT}
- bounded_exec_license: ${BOUNDED_EXEC_LICENSE}
coverage:
- authority-free no-std credential admission
- explicit manifest, profile, scope, declaration, provider, purpose, destination, and bounds
- read-only environment, systemd credential, and SOPS provider paths
- outer resolver worker and inner read-only SOPS guard with deadlines and output limits
- missing, malformed, nonzero, timeout, cancellation, overflow, and teardown classifications
- zeroizing non-cloneable material and borrowed representative provider delivery
- metadata-only receipts without values, value hashes, provider credentials, child output, or private paths
- default, no-default, Wasm, catalog, facade, and dependency isolation
non_claims:
- no caller authority, credential correctness, freshness, provider integrity, runtime safety, production readiness, or release eligibility is established
EOF

printf '%s\n' 'focused rail secretspec-host-resolution: pass'
printf 'receipt: %s\n' "${RECEIPT}"
