#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly POLICY_RELATIVE_PATH=policy/model-router/recipe-policy.ncl
readonly GENERATED_POLICY_RELATIVE_PATH=policy/model-router/generated/router-recipe-policy.json
readonly INDEX_RELATIVE_PATH=cairn/router-conformance-index.ncl
readonly FIXTURE_DIR=cairn/router-conformance-index-fixtures
readonly POLICY_LINES_FIELD=family_policy_lines
readonly FIXTURE_LINES_FIELD=fixture_lines
readonly POLICY_JSON_FIELD=router_recipe_policy
readonly EXPECTED_FIELD=expected_issue
readonly EXPECTED_OK=OK

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

if ! command -v nickel >/dev/null 2>&1; then
  printf '%s\n' 'error: nickel is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

rust_source=${script_dir}/check-router-policy.rs
if [ -n "${TMPDIR:-}" ]; then
  tmp_parent=${TMPDIR}
else
  tmp_parent=${repo_root}/target/tmp
fi
mkdir -p "${tmp_parent}"
TMPDIR=${tmp_parent}
TMP=${tmp_parent}
TEMP=${tmp_parent}
export TMPDIR TMP TEMP
tmp_dir=$(mktemp -d "${tmp_parent}/animus-router-policy.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM

checker=${tmp_dir}/check-router-policy
rustc --edition=2021 "${rust_source}" -o "${checker}"

policy_source=${repo_root}/${POLICY_RELATIVE_PATH}
generated_policy=${repo_root}/${GENERATED_POLICY_RELATIVE_PATH}
index_source=${repo_root}/${INDEX_RELATIVE_PATH}
rust_policy=${repo_root}/crates/animus-router/src/policy.rs
policy_lines=${tmp_dir}/policy.lines
source_policy_json=${tmp_dir}/router-recipe-policy.json
fixture_lines=${tmp_dir}/fixtures.lines

nickel export --format raw --field "${POLICY_LINES_FIELD}" "${policy_source}" > "${policy_lines}"
nickel export --format json --field "${POLICY_JSON_FIELD}" "${policy_source}" > "${source_policy_json}"
nickel export --format raw --field "${FIXTURE_LINES_FIELD}" "${index_source}" > "${fixture_lines}"

if ! cmp -s "${source_policy_json}" "${generated_policy}"; then
  printf '%s\n' 'ERROR ROUTER_POLICY_DRIFT generated router policy JSON differs from Nickel source' >&2
  exit "${FAILURE}"
fi

if command -v b3sum >/dev/null 2>&1; then
  printf 'router_policy_b3=%s\n' "$(b3sum "${source_policy_json}" | awk '{print $1}')"
  printf 'router_fixture_b3=%s\n' "$(b3sum "${fixture_lines}" | awk '{print $1}')"
else
  printf '%s\n' 'router_policy_b3=unavailable:b3sum-not-on-path'
  printf '%s\n' 'router_fixture_b3=unavailable:b3sum-not-on-path'
fi

"${checker}" \
  --policy-lines "${policy_lines}" \
  --fixtures "${fixture_lines}" \
  --generated-policy "${generated_policy}" \
  --source-policy "${source_policy_json}" \
  --rust-policy "${rust_policy}"

if [ -d "${repo_root}/${FIXTURE_DIR}" ]; then
  for fixture in "${repo_root}/${FIXTURE_DIR}"/*.ncl; do
    if [ ! -e "${fixture}" ]; then
      continue
    fi
    fixture_name=$(basename "${fixture}" .ncl)
    fixture_output=${tmp_dir}/${fixture_name}.out
    fixture_lines_file=${tmp_dir}/${fixture_name}.fixtures.lines
    expected_issue=$(nickel export --format raw --field "${EXPECTED_FIELD}" "${fixture}")
    nickel export --format raw --field "${FIXTURE_LINES_FIELD}" "${fixture}" > "${fixture_lines_file}"

    if [ "${expected_issue}" = "${EXPECTED_OK}" ]; then
      "${checker}" \
        --policy-lines "${policy_lines}" \
        --fixtures "${fixture_lines_file}" \
        --generated-policy "${generated_policy}" \
        --source-policy "${source_policy_json}" \
        --rust-policy "${rust_policy}" > "${fixture_output}" 2>&1
      printf 'positive fixture ok: %s\n' "${fixture_name}"
      continue
    fi

    if ! "${checker}" \
      --policy-lines "${policy_lines}" \
      --fixtures "${fixture_lines_file}" \
      --generated-policy "${generated_policy}" \
      --source-policy "${source_policy_json}" \
      --rust-policy "${rust_policy}" > "${fixture_output}" 2>&1; then
      printf 'error: fixture %s did not validate expected issue %s\n' "${fixture_name}" "${expected_issue}" >&2
      cat "${fixture_output}" >&2
      exit "${FAILURE}"
    fi
    printf 'negative fixture ok: %s -> %s\n' "${fixture_name}" "${expected_issue}"
  done
fi
