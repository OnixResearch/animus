#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly ROADMAP_FIELD=roadmap_lines
readonly EXPECTED_FIELD=expected_issue
readonly EXPECTED_CONTAINS_FIELD=expected_contains

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

review_markdown=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --root)
      if [ -z "${2:-}" ]; then
        printf '%s\n' 'error: --root requires a path' >&2
        exit "${FAILURE}"
      fi
      repo_root=$(CDPATH= cd -- "$2" && pwd)
      shift 2
      ;;
    --review-markdown)
      review_markdown=true
      shift
      ;;
    *)
      printf 'error: unknown argument: %s\n' "$1" >&2
      exit "${FAILURE}"
      ;;
  esac
done

roadmap_source=${repo_root}/cairn/roadmap.ncl
fixture_dir=${repo_root}/cairn/roadmap-fixtures
positive_fixture_dir=${repo_root}/cairn/roadmap-positive-fixtures
rust_source=${script_dir}/check-roadmap.rs

if ! command -v nickel >/dev/null 2>&1; then
  printf '%s\n' 'error: nickel is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-roadmap.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM

checker=${tmp_dir}/check-roadmap
rustc --edition=2021 "${rust_source}" -o "${checker}"

roadmap_lines=${tmp_dir}/roadmap.lines
nickel export --format raw --field "${ROADMAP_FIELD}" "${roadmap_source}" > "${roadmap_lines}"
if [ "${review_markdown}" = true ]; then
  "${checker}" --root "${repo_root}" --roadmap "${roadmap_lines}" --review-markdown
else
  "${checker}" --root "${repo_root}" --roadmap "${roadmap_lines}"
fi

assert_no_fixture_leak() {
  fixture_name=$1
  fixture_output=$2
  if grep -E '(/home/|/tmp/|sk-[A-Za-z0-9]|AKIA|BEGIN (OPENSSH|RSA|PRIVATE KEY)|provider_payload|raw prompt|diff --git|TOKEN=|SECRET=|PASSWORD=)' "${fixture_output}" >/dev/null 2>&1; then
    printf 'error: fixture %s output leaked unsafe material\n' "${fixture_name}" >&2
    cat "${fixture_output}" >&2
    exit "${FAILURE}"
  fi
}

if [ -d "${positive_fixture_dir}" ]; then
  for fixture in "${positive_fixture_dir}"/*.ncl; do
    if [ ! -e "${fixture}" ]; then
      continue
    fi
    fixture_name=$(basename "${fixture}" .ncl)
    fixture_lines=${tmp_dir}/${fixture_name}.lines
    fixture_output=${tmp_dir}/${fixture_name}.out
    expected_contains=${tmp_dir}/${fixture_name}.expected
    nickel export --format raw --field "${ROADMAP_FIELD}" "${fixture}" > "${fixture_lines}"
    nickel export --format raw --field "${EXPECTED_CONTAINS_FIELD}" "${fixture}" > "${expected_contains}"
    if ! "${checker}" --root "${repo_root}" --roadmap "${fixture_lines}" > "${fixture_output}" 2>&1; then
      printf 'error: positive fixture %s unexpectedly failed\n' "${fixture_name}" >&2
      cat "${fixture_output}" >&2
      exit "${FAILURE}"
    fi
    while IFS= read -r expected_line || [ -n "${expected_line}" ]; do
      if [ -z "${expected_line}" ]; then
        continue
      fi
      if ! grep -F "${expected_line}" "${fixture_output}" >/dev/null 2>&1; then
        printf 'error: positive fixture %s missing expected output line: %s\n' "${fixture_name}" "${expected_line}" >&2
        cat "${fixture_output}" >&2
        exit "${FAILURE}"
      fi
    done < "${expected_contains}"
    assert_no_fixture_leak "${fixture_name}" "${fixture_output}"
    printf 'positive fixture ok: %s\n' "${fixture_name}"
  done
fi

if [ -d "${fixture_dir}" ]; then
  for fixture in "${fixture_dir}"/*.ncl; do
    if [ ! -e "${fixture}" ]; then
      continue
    fi
    fixture_name=$(basename "${fixture}" .ncl)
    fixture_lines=${tmp_dir}/${fixture_name}.lines
    fixture_output=${tmp_dir}/${fixture_name}.out
    expected_issue=$(nickel export --format raw --field "${EXPECTED_FIELD}" "${fixture}")
    nickel export --format raw --field "${ROADMAP_FIELD}" "${fixture}" > "${fixture_lines}"
    if "${checker}" --root "${repo_root}" --roadmap "${fixture_lines}" > "${fixture_output}" 2>&1; then
      printf 'error: fixture %s unexpectedly passed\n' "${fixture_name}" >&2
      cat "${fixture_output}" >&2
      exit "${FAILURE}"
    fi
    if ! grep -F "ERROR ${expected_issue}" "${fixture_output}" >/dev/null 2>&1; then
      printf 'error: fixture %s did not report expected issue %s\n' "${fixture_name}" "${expected_issue}" >&2
      cat "${fixture_output}" >&2
      exit "${FAILURE}"
    fi
    assert_no_fixture_leak "${fixture_name}" "${fixture_output}"
    printf 'negative fixture ok: %s -> %s\n' "${fixture_name}" "${expected_issue}"
  done
fi
