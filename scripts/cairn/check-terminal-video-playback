#!/usr/bin/env sh
set -eu
readonly FAILURE=1
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v rustc >/dev/null 2>&1 || { printf '%s\n' 'error: rustc is required' >&2; exit "${FAILURE}"; }
command -v nickel >/dev/null 2>&1 || { printf '%s\n' 'error: nickel is required' >&2; exit "${FAILURE}"; }
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-terminal-video.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM
rustc --edition=2021 "${script_dir}/check-terminal-video-playback.rs" -o "${tmp_dir}/check"
rustc --edition=2021 --test "${script_dir}/check-terminal-video-playback.rs" -o "${tmp_dir}/check-tests"
"${tmp_dir}/check-tests"
"${tmp_dir}/check" "$@"
root='.'
if [ "${1:-}" = '--root' ]; then root=${2:-.}; fi
cd "${root}"
exported="${tmp_dir}/terminal-video-policy.json"
nickel export --format json --field terminal_video_policy config/terminal-video-policy.ncl > "${exported}"
diff -u config/generated/terminal-video-policy.json "${exported}"
nickel typecheck fixtures/terminal-video/positive.ncl
nickel typecheck fixtures/terminal-video/negative.ncl
cargo test -p animus-tui --features terminal-video --locked
cargo clippy -p animus-tui --all-targets --features terminal-video --locked -- -D warnings
cargo check -p animus-tui --no-default-features --locked
cargo check -p animus --features terminal-video --locked
cargo check -p animus --no-default-features --locked
cargo check -p animus-adapters --no-default-features --target wasm32-unknown-unknown --locked
cargo check -p animus-runtime --no-default-features --target wasm32-unknown-unknown --locked
cargo check -p animus-steel --no-default-features --target wasm32-unknown-unknown --locked
cargo tree -p animus-tui --no-default-features --locked > "${tmp_dir}/default-tree.txt"
if grep -Eq 'rat-image|image v|base64 v' "${tmp_dir}/default-tree.txt"; then
  printf '%s\n' 'error: terminal image dependencies leaked into default animus-tui tree' >&2
  exit "${FAILURE}"
fi
cargo tree -p animus-tui --features terminal-video --locked > "${tmp_dir}/terminal-video-tree.txt"
grep -q 'rat-image' "${tmp_dir}/terminal-video-tree.txt"
grep -q 'image v' "${tmp_dir}/terminal-video-tree.txt"
grep -q 'base64 v' "${tmp_dir}/terminal-video-tree.txt"
if grep -Eqi 'ffmpeg|gstreamer|rodio|cpal|reqwest' "${tmp_dir}/terminal-video-tree.txt"; then
  printf '%s\n' 'error: decoder, audio, or network dependency entered terminal-video tree' >&2
  exit "${FAILURE}"
fi
printf '%s\n' 'focused rail terminal-video-playback: pass'
