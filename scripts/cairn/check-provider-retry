#!/usr/bin/env sh
# r[impl agent_harness_runtime.tau_provider_retry.verification]
# r[verify agent_harness_runtime.tau_provider_retry.verification]
set -eu

readonly FAILURE=1
readonly RECEIPT_SCHEMA='animus.focused-rail-receipt.v1'
readonly RAIL_NAME='provider-retry'
readonly POLICY_SOURCE='config/provider-retry-policy.ncl'
readonly GENERATED_POLICY='config/generated/provider-retry-policy.json'
readonly POLICY_FIXTURES='config/provider-retry-policy/fixtures'
readonly RUNTIME_SOURCE='crates/animus-runtime/src/resilience'
readonly STD_SOURCE='crates/animus-std/src/providerretry.rs'
readonly STD_TEST_SOURCE='crates/animus-std/src/providerretry/tests.rs'
readonly RUNTIME_ROOT='crates/animus-runtime/src/lib.rs'
readonly RUNTIME_EVENT_SOURCE='crates/animus-runtime/src/telemetry/dto.rs'
readonly HEADLESS_EVENT_SOURCE='crates/animus-runtime/src/headless/protocol/parts/events.rs'
readonly STD_ROOT='crates/animus-std/src/lib.rs'
readonly PRESERVES_SOURCE='crates/animus-preserves/src/message.rs'
readonly TUI_SOURCE='crates/animus-tui/src/view/conversationmod.rs'
readonly TUI_TEST_SOURCE='crates/animus-tui/src/view/conversationtest.rs'
readonly CONTRACT_DOC='docs/provider-retry-execution.md'

root='.'
if [ "${1:-}" = '--root' ]; then
  root=${2:-.}
fi
cd "${root}"

for command_name in cargo nickel b3sum; do
  if ! command -v "${command_name}" >/dev/null 2>&1; then
    printf 'error: %s is required for provider-retry checks\n' "${command_name}" >&2
    exit "${FAILURE}"
  fi
done

for marker in \
  'validate_provider_retry_policy' \
  'classify_provider_retry_failure' \
  'plan_provider_retry' \
  'plan_provider_retry_wait' \
  'evaluate_provider_retry_timer' \
  'advance_provider_retry_attempt' \
  'validate_provider_retry_progress_event' \
  'project_provider_retry_receipt'
do
  if ! grep -R -F "${marker}" "${RUNTIME_SOURCE}" --include='*.rs' >/dev/null; then
    printf 'error: provider-retry marker is missing: %s\n' "${marker}" >&2
    exit "${FAILURE}"
  fi
done

if ! grep -F 'pub mod provider_retry {' "${RUNTIME_ROOT}" >/dev/null; then
  printf '%s\n' 'error: provider-retry public module is missing' >&2
  exit "${FAILURE}"
fi
if ! grep -F 'does not prove provider behavior' "${CONTRACT_DOC}" >/dev/null; then
  printf '%s\n' 'error: provider retry non-claim boundary is undocumented' >&2
  exit "${FAILURE}"
fi

if grep -R -E 'std::fs|std::process|Command::new|std::env|TcpStream|UdpSocket|SystemTime::now|Instant::now|thread::sleep|tokio::time|reqwest|hyper::' \
  "${RUNTIME_SOURCE}" --include='*.rs' >/dev/null 2>&1
then
  printf '%s\n' 'error: provider-retry pure core gained ambient timer, network, or host authority' >&2
  exit "${FAILURE}"
fi

nickel export --format json --field provider_retry_policy "${POLICY_SOURCE}" >/dev/null
nickel export --format json --field fixture "${POLICY_FIXTURES}/valid-minimal.ncl" >/dev/null
fixture_error=$(mktemp)
trap 'rm -f "${fixture_error}"' EXIT HUP INT TERM
for fixture in "${POLICY_FIXTURES}"/negative-*.ncl; do
  expected_issue=$(nickel export --format raw --field expected_issue "${fixture}")
  if nickel export --format json --field fixture "${fixture}" >/dev/null 2>"${fixture_error}"; then
    printf 'error: negative provider-retry fixture unexpectedly passed: %s\n' "${fixture}" >&2
    exit "${FAILURE}"
  fi
  if ! grep -F "${expected_issue}" "${fixture_error}" >/dev/null; then
    printf 'error: provider-retry fixture missed issue %s: %s\n' "${expected_issue}" "${fixture}" >&2
    exit "${FAILURE}"
  fi
done

cargo test -p animus-runtime --locked resilience
cargo test -p animus-std --features provider-retry --locked providerretry
cargo test -p animus-preserves --locked provider_retry_progress
cargo test -p animus-tui --locked provider_retry_progress
cargo clippy -p animus-runtime --all-targets --locked -- -D warnings
cargo clippy -p animus-std --all-targets --features provider-retry --locked -- -D warnings
cargo clippy -p animus-preserves --all-targets --locked -- -D warnings
cargo clippy -p animus-tui --all-targets --locked -- -D warnings
cargo check -p animus-runtime --no-default-features --locked
cargo check -p animus-std --no-default-features --locked
cargo check -p animus --no-default-features --locked

source_hash=$(
  b3sum \
    "${POLICY_SOURCE}" \
    "${POLICY_FIXTURES}"/*.ncl \
    "${GENERATED_POLICY}" \
    "${RUNTIME_SOURCE}/mod.rs" \
    "${RUNTIME_SOURCE}/data.rs" \
    "${RUNTIME_SOURCE}/core.rs" \
    "${RUNTIME_SOURCE}/receipt.rs" \
    "${RUNTIME_SOURCE}/tests.rs" \
    "${RUNTIME_ROOT}" \
    "${RUNTIME_EVENT_SOURCE}" \
    "${HEADLESS_EVENT_SOURCE}" \
    "${STD_SOURCE}" \
    "${STD_TEST_SOURCE}" \
    "${STD_ROOT}" \
    "${PRESERVES_SOURCE}" \
    "${TUI_SOURCE}" \
    "${TUI_TEST_SOURCE}" | b3sum | cut -d ' ' -f 1
)
mkdir -p target/cairn/focused-rails
receipt_path=target/cairn/focused-rails/${RAIL_NAME}.md
cat > "${receipt_path}" <<EOF
schema: ${RECEIPT_SCHEMA}
rail: ${RAIL_NAME}
status: pass
source_blake3: ${source_hash}
claims: generated-policy-revalidation,versioned-safe-classification,bounded-same-plan-retry,semantic-stream-stop,threaded-cancellable-wait,exact-dispatch-gate,provider-neutral-progress,metadata-only-receipt
non_claims: provider-behavior,provider-availability,exactly-once-effects,timer-correctness,delivery,completion,production-readiness
EOF

printf '%s\n' 'focused rail provider-retry: pass'
printf 'receipt: %s\n' "${receipt_path}"
