#!/usr/bin/env sh
set -eu

readonly FAILURE=1
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

checker_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-lean4-loop.XXXXXX")
trap 'rm -rf "${checker_dir}"' EXIT HUP INT TERM
checker=${checker_dir}/check-lean4-loop-fabric
rustc --edition=2021 "${script_dir}/check-lean4-loop-fabric.rs" -o "${checker}"
exec "${checker}" --root "${repo_root}"
