#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly TARGET=wasm32-unknown-unknown
readonly FIXTURE_DIR=cairn/wasm-surface-fixtures

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

if ! command -v cargo >/dev/null 2>&1; then
  printf '%s\n' 'error: cargo is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

rust_source=${script_dir}/check-wasm-surface.rs
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-wasm-surface.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM

checker=${tmp_dir}/check-wasm-surface
rustc --edition=2021 "${rust_source}" -o "${checker}"

cd "${repo_root}"

cargo check -p animus-core --target "${TARGET}" --locked
cargo check -p animus-adapter-safe --target "${TARGET}" --locked
cargo check -p animus-adapter-rlm-kernel --target "${TARGET}" --locked
cargo check -p animus-adapter-observability --target "${TARGET}" --locked
cargo check -p animus-adapters --target "${TARGET}" --locked
cargo check -p animus-router --target "${TARGET}" --locked
cargo check -p animus --no-default-features --target "${TARGET}" --locked

cargo tree \
  -p animus \
  --no-default-features \
  --target "${TARGET}" \
  --locked \
  --edges normal \
  --prefix none \
  > "${tmp_dir}/wasm-surface.tree"

"${checker}" --root "${repo_root}" --tree "${tmp_dir}/wasm-surface.tree"

if [ -d "${repo_root}/${FIXTURE_DIR}" ]; then
  for fixture in "${repo_root}/${FIXTURE_DIR}"/*; do
    if [ ! -e "${fixture}" ]; then
      continue
    fi
    "${checker}" --root "${repo_root}" --fixture "${fixture}"
  done
fi
