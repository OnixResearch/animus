#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly INVENTORY_RELATIVE_PATH=.cairn/runtime-facade-inventory.ncl
readonly FIXTURE_DIR=.cairn/runtime-facade-inventory-fixtures
readonly INVENTORY_FIELD=inventory_lines
readonly PUBLIC_EXPORTS_FIELD=public_export_lines
readonly EXPECTED_FIELD=expected_issue
readonly EXPECTED_OK=OK

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

if ! command -v nickel >/dev/null 2>&1; then
  printf '%s\n' 'error: nickel is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

rust_source=${script_dir}/check-runtime-facade-inventory.rs
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-runtime-facade-inventory.XXXXXX")
trap 'rm -rf "${tmp_dir}"' EXIT HUP INT TERM

checker=${tmp_dir}/check-runtime-facade-inventory
rustc --edition=2021 "${rust_source}" -o "${checker}"

inventory_source=${repo_root}/${INVENTORY_RELATIVE_PATH}
inventory_lines=${tmp_dir}/inventory.lines
nickel export --format raw --field "${INVENTORY_FIELD}" "${inventory_source}" > "${inventory_lines}"

if command -v b3sum >/dev/null 2>&1; then
  printf 'inventory_b3=%s\n' "$(b3sum "${inventory_lines}" | awk '{print $1}')"
else
  printf '%s\n' 'inventory_b3=unavailable:b3sum-not-on-path'
fi

"${checker}" --root "${repo_root}" --inventory "${inventory_lines}"

if [ -d "${repo_root}/${FIXTURE_DIR}" ]; then
  for fixture in "${repo_root}/${FIXTURE_DIR}"/*.ncl; do
    if [ ! -e "${fixture}" ]; then
      continue
    fi
    fixture_name=$(basename "${fixture}" .ncl)
    fixture_inventory=${tmp_dir}/${fixture_name}.inventory.lines
    fixture_exports=${tmp_dir}/${fixture_name}.exports.lines
    fixture_output=${tmp_dir}/${fixture_name}.out
    expected_issue=$(nickel export --format raw --field "${EXPECTED_FIELD}" "${fixture}")
    nickel export --format raw --field "${INVENTORY_FIELD}" "${fixture}" > "${fixture_inventory}"
    nickel export --format raw --field "${PUBLIC_EXPORTS_FIELD}" "${fixture}" > "${fixture_exports}"

    if [ "${expected_issue}" = "${EXPECTED_OK}" ]; then
      "${checker}" --root "${repo_root}" --inventory "${fixture_inventory}" --public-exports "${fixture_exports}" > "${fixture_output}" 2>&1
      printf 'positive fixture ok: %s\n' "${fixture_name}"
      continue
    fi

    if "${checker}" --root "${repo_root}" --inventory "${fixture_inventory}" --public-exports "${fixture_exports}" > "${fixture_output}" 2>&1; then
      printf 'error: fixture %s unexpectedly passed\n' "${fixture_name}" >&2
      cat "${fixture_output}" >&2
      exit "${FAILURE}"
    fi
    if ! grep -F "ERROR ${expected_issue}" "${fixture_output}" >/dev/null 2>&1; then
      printf 'error: fixture %s did not report expected issue %s\n' "${fixture_name}" "${expected_issue}" >&2
      cat "${fixture_output}" >&2
      exit "${FAILURE}"
    fi
    printf 'negative fixture ok: %s -> %s\n' "${fixture_name}" "${expected_issue}"
  done
fi
