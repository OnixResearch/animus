#!/usr/bin/env sh
set -eu

readonly FAILURE=1
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi
if ! command -v nickel >/dev/null 2>&1; then
  printf '%s\n' 'error: nickel is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

checker_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-daemon-workers.XXXXXX")
trap 'rm -rf "${checker_dir}"' EXIT HUP INT TERM
checker=${checker_dir}/check-daemon-workers
rustc --edition=2021 "${script_dir}/check-daemon-workers.rs" -o "${checker}"
"${checker}" "$@"

root='.'
if [ "${1:-}" = '--root' ]; then
  root=${2:-.}
fi
cd "${root}"

policy_export=$(mktemp)
trap 'rm -f "${policy_export}"; rm -rf "${checker_dir}"' EXIT HUP INT TERM
nickel export --format json --field daemon_workers_policy config/daemon-workers-policy.ncl > "${policy_export}"
diff -u config/generated/daemon-workers-policy.json "${policy_export}"

cargo test -p animus-adapter-daemon --locked
cargo check -p animus-adapter-daemon --no-default-features --locked
cargo check -p animus --no-default-features --features daemon-workers --locked
printf '%s\n' 'focused rail daemon-workers: pass'
