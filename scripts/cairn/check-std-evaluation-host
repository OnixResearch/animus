#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly ROOT_FLAG=--root
readonly DEFAULT_ROOT=.
readonly CHECKER_SOURCE=scripts/cairn/check-std-evaluation-host.rs
readonly CHECKER_TARGET=target/cairn/check-std-evaluation-host
readonly RECEIPT=target/cairn/focused-rails/std-evaluation-host.md
readonly SOURCE_COHORT_MATERIAL='animus.native-evaluation-host.source.v1:PrimeIntellect-ai/verifiers:1a997814e85a2e4f409add960aa852737388dbd8:verifiers/v1/cli/eval/runner.py,verifiers/v1/cli/eval/resume.py,verifiers/v1/episode.py,verifiers/v1/interception/base.py,verifiers/v1/interception/pool.py,verifiers/v1/interception/server.py,verifiers/v1/rollout.py,verifiers/v1/runtimes/limiters.py,verifiers/v1/state.py,verifiers/v1/utils/artifacts.py'
readonly SOURCE_COHORT_HASH='c6336b188596db9b18cb2f0a721c9f5bc551e619342e89807e20ec45f3bb676f'

root=${DEFAULT_ROOT}
if [ "${1:-}" = "${ROOT_FLAG}" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  root=$2
fi
cd "${root}"

if ! command -v b3sum >/dev/null 2>&1; then
  printf '%s\n' 'error: b3sum is required for the source-cohort identity check' >&2
  exit "${FAILURE}"
fi
computed_source_hash=$(printf '%s' "${SOURCE_COHORT_MATERIAL}" | b3sum | awk '{print $1}')
if [ "${computed_source_hash}" != "${SOURCE_COHORT_HASH}" ]; then
  printf '%s\n' 'error: standard evaluation host source-cohort identity drifted' >&2
  exit "${FAILURE}"
fi

mkdir -p "$(dirname "${CHECKER_TARGET}")" "$(dirname "${RECEIPT}")"
rustc --edition=2021 --test "${CHECKER_SOURCE}" -o "${CHECKER_TARGET}-tests"
"${CHECKER_TARGET}-tests"
rustc --edition=2021 "${CHECKER_SOURCE}" -o "${CHECKER_TARGET}"
"${CHECKER_TARGET}" .
nickel export --format json fixtures/evaluation-host/positive.ncl >/dev/null
nickel export --format json fixtures/evaluation-host/negative.ncl >/dev/null

cargo test -p animus-std-eval --locked
cargo clippy -p animus-std-eval --all-targets -- -D warnings
cargo check -p animus --no-default-features --locked
cargo check -p animus --no-default-features --features evaluation-host --locked
cargo check -p animus-adapter-eval --target wasm32-unknown-unknown --locked
if [ "${ANIMUS_STD_EVAL_SKIP_NICKEL:-0}" != "1" ]; then
  scripts/config/check-nickel-configs
fi
sh scripts/cairn/check-component-catalog --root .
sh scripts/cairn/check-runtime-facade-inventory --root .
sh scripts/cairn/check-composition-conformance --root .
sh scripts/cairn/check-active-turn-recovery --root .
sh scripts/cairn/check-durable-session-store --root .
sh scripts/cairn/check-evidence-safety --root .

if cargo tree -p animus --edges normal --format '{lib}' | grep -Fq 'animus_std_eval'; then
  printf '%s\n' 'error: evaluation host leaked into the default root facade' >&2
  exit "${FAILURE}"
fi
if ! cargo tree -p animus --no-default-features --features evaluation-host --edges normal --format '{lib}' | grep -Fq 'animus_std_eval'; then
  printf '%s\n' 'error: evaluation-host feature does not select animus-std-eval' >&2
  exit "${FAILURE}"
fi
if cargo tree -p animus-std-eval --edges normal --format '{lib}' | grep -Eiq '(^|[-_])(tokio|reqwest|hyper|axum|bollard|kube|python|pydantic|harbor)([-_]|$)'; then
  printf '%s\n' 'error: prohibited concrete runtime dependency leaked into animus-std-eval' >&2
  exit "${FAILURE}"
fi

cat >"${RECEIPT}" <<'EOF'
# Standard native evaluation host focused rail

- verdict: PASS
- boundary: non-default standard-library shell over explicit services
- policy: checked Nickel projection with strict Rust parsing
- lifecycle: bounded episode and agent permits with cancellation, deadline, seal, and cleanup handling
- gateway: separate capabilities, durable acceptance, exact retry, and terminal-after-commit
- verifier: distinct environment with allowlisted collision-free artifact handoff
- persistence: explicit logical target with append, replacement, reopen, and resume-safe classifications
- receipts: metadata only with explicit leak and overclaim rejection
- isolation: default, no-default, reusable Wasm, dependency, component, facade, composition, active-turn, durable-store, and evidence checks passed
- non-claims: no confinement, network enforcement, provider correctness, durability, exactly-once, verifier soundness, artifact authenticity, benchmark, completion, production, or release claim
EOF

printf '%s\n' 'focused rail std-evaluation-host: pass'
printf 'receipt: %s\n' "${RECEIPT}"
