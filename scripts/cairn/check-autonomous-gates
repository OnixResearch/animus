#!/usr/bin/env sh
set -eu

readonly FAILURE=1
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v rustc >/dev/null 2>&1; then
  printf '%s\n' 'error: rustc is required. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

checker_dir=$(mktemp -d "${TMPDIR:-/tmp}/animus-autonomous-gates.XXXXXX")
trap 'rm -rf "${checker_dir}"' EXIT HUP INT TERM
checker=${checker_dir}/check-autonomous-gates
rustc --edition=2021 "${script_dir}/check-autonomous-gates.rs" -o "${checker}"
"${checker}" "$@"
