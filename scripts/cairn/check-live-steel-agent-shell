#!/usr/bin/env sh
# r[verify agent_harness_runtime.live_steel_agent_shell.verification]
set -eu

readonly FAILURE=1
root='.'
if [ "${1:-}" = '--root' ]; then
  root=${2:-.}
fi
cd "${root}"

readonly DEFAULT_CARGO_TARGET_DIR="${PWD}/target/live-steel-agent-shell-cargo"
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-${DEFAULT_CARGO_TARGET_DIR}}

for tool in cargo grep; do
  if ! command -v "${tool}" >/dev/null 2>&1; then
    printf 'error: %s is required for the live Steel agent shell rail\n' "${tool}" >&2
    exit "${FAILURE}"
  fi
done

cargo test -p animus-live-steel-agent --all-features --locked
cargo clippy -p animus-live-steel-agent --all-targets --all-features --locked -- -D warnings
cargo check -p animus-live-steel-agent --no-default-features --locked
cargo tree -p animus-live-steel-agent --no-default-features --locked > /dev/null

readonly MANIFEST='crates/animus-live-steel-agent/Cargo.toml'
readonly CONFIG='config/live-steel-agent-shell.ncl'
readonly GENERATED='config/generated/live-steel-agent-shell.json'
readonly APPLICATION='crates/animus-live-steel-agent/src/entrypoint/mod.rs'
readonly SHELL='crates/animus-live-steel-agent/src/assembly/opening.rs'
readonly STORE='crates/animus-live-steel-agent/src/durable/recovery.rs'
readonly TOOL='crates/animus-live-steel-agent/src/evaluation/mod.rs'
readonly RECEIPT='crates/animus-live-steel-agent/src/evidence/mod.rs'
readonly DOC='docs/live-steel-agent-shell.md'

for file in "${MANIFEST}" "${CONFIG}" "${GENERATED}" "${APPLICATION}" "${SHELL}" "${STORE}" "${TOOL}" "${RECEIPT}" "${DOC}"; do
  test -f "${file}" || {
    printf 'error: required live shell artifact is missing: %s\n' "${file}" >&2
    exit "${FAILURE}"
  }
done

grep -F 'license = "AGPL-3.0-or-later"' "${MANIFEST}" >/dev/null
grep -F 'default = []' "${MANIFEST}" >/dev/null
grep -F 'live-provider = ["animus-std-openai/reqwest-client"]' "${MANIFEST}" >/dev/null
grep -F 'animus-live-steel-agent' Cargo.toml >/dev/null
if awk '/default-members = \[/,/^\]/' Cargo.toml | grep -F 'animus-live-steel-agent' >/dev/null; then
  printf '%s\n' 'error: live Steel agent entered workspace default members' >&2
  exit "${FAILURE}"
fi

grep -F 'let LiveSteelAgentShell = {' "${CONFIG}" >/dev/null
grep -F '"schema": "animus.live-steel-agent-shell.v1"' "${GENERATED}" >/dev/null
grep -F 'pub fn run_live_application' "${APPLICATION}" >/dev/null
grep -F 'CodingSessionHost::new' "${SHELL}" >/dev/null
grep -F 'restore_interrupted_kernel' "${STORE}" >/dev/null
grep -F 'execute_bridged_cell' "${TOOL}" >/dev/null
grep -F 'prompt-provider-tool-steel-host-child-credential-and-path-content-omitted' "${RECEIPT}" >/dev/null
grep -F 'provider correctness remains a non-claim' "${DOC}" >/dev/null
grep -F 'std.live-steel-agent-shell' .cairn/component-catalog.ncl >/dev/null
grep -F 'animus-live-steel-agent::run_live_application' .cairn/runtime-facade-inventory.ncl >/dev/null

sh scripts/cairn/check-component-catalog --root .
sh scripts/cairn/check-runtime-facade-inventory --root .

printf '%s\n' 'focused rail live-steel-agent-shell: pass'
printf '%s\n' 'live provider smoke: not run; provider correctness remains a non-claim'
