#!/usr/bin/env sh
set -eu

readonly FAILURE=1
readonly FIXTURE_DIR=.cairn/evidence-safety-fixtures
readonly ISSUE_RAW_PROMPT=EVIDENCE_RAW_PROMPT
readonly ISSUE_CREDENTIAL=EVIDENCE_CREDENTIAL
readonly ISSUE_PROVIDER_PAYLOAD=EVIDENCE_PROVIDER_PAYLOAD
readonly ISSUE_FULL_PRIVATE_PATH=EVIDENCE_FULL_PRIVATE_PATH
readonly ISSUE_UNBOUNDED_OUTPUT=EVIDENCE_UNBOUNDED_OUTPUT
readonly EXPECTED_PREFIX='expected_issue='

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)

if [ "${1:-}" = "--root" ]; then
  if [ -z "${2:-}" ]; then
    printf '%s\n' 'error: --root requires a path' >&2
    exit "${FAILURE}"
  fi
  repo_root=$(CDPATH= cd -- "$2" && pwd)
fi

scan_file() {
  file=$1
  if grep -q 'RAW_PROMPT:' "${file}"; then
    printf '%s\n' "${ISSUE_RAW_PROMPT}"
    return 0
  fi
  if grep -Eq 'sk-[[:alnum:]_-]+|BEGIN [A-Z ]*PRIVATE KEY|AWS_SECRET_ACCESS_KEY|API_KEY=' "${file}"; then
    printf '%s\n' "${ISSUE_CREDENTIAL}"
    return 0
  fi
  if grep -q 'PROVIDER_PAYLOAD:' "${file}"; then
    printf '%s\n' "${ISSUE_PROVIDER_PAYLOAD}"
    return 0
  fi
  if grep -Eq '/home/[^[:space:]]+' "${file}"; then
    printf '%s\n' "${ISSUE_FULL_PRIVATE_PATH}"
    return 0
  fi
  if grep -q 'UNBOUNDED_OUTPUT:' "${file}"; then
    printf '%s\n' "${ISSUE_UNBOUNDED_OUTPUT}"
    return 0
  fi
  return 1
}

relative_path() {
  path=$1
  case "${path}" in
    "${repo_root}"/*) printf '%s\n' "${path#"${repo_root}"/}" ;;
    *) printf '%s\n' "${path}" ;;
  esac
}

failed=0

if [ -d "${repo_root}/${FIXTURE_DIR}" ]; then
  for fixture in "${repo_root}/${FIXTURE_DIR}"/*.md; do
    if [ ! -e "${fixture}" ]; then
      continue
    fi
    expected=$(sed -n "s/^${EXPECTED_PREFIX}//p" "${fixture}")
    if [ -z "${expected}" ]; then
      printf 'error: fixture missing expected issue: %s\n' "$(relative_path "${fixture}")" >&2
      failed=1
      continue
    fi
    if issue=$(scan_file "${fixture}"); then
      if [ "${issue}" = "${expected}" ]; then
        printf 'negative fixture ok: %s -> %s\n' "$(relative_path "${fixture}")" "${issue}"
      else
        printf 'error: fixture %s reported %s, expected %s\n' "$(relative_path "${fixture}")" "${issue}" "${expected}" >&2
        failed=1
      fi
    else
      printf 'error: fixture did not report expected issue: %s\n' "$(relative_path "${fixture}")" >&2
      failed=1
    fi
  done
fi

find "${repo_root}/.cairn/changes" "${repo_root}/.cairn/archive" -name evidence.md -type f 2>/dev/null | sort | while IFS= read -r evidence_file; do
  if issue=$(scan_file "${evidence_file}"); then
    printf 'error: %s in %s\n' "${issue}" "$(relative_path "${evidence_file}")" >&2
    exit "${FAILURE}"
  fi
done

if [ "${failed}" -ne 0 ]; then
  exit "${FAILURE}"
fi

printf '%s\n' 'evidence safety: ok'
