local_daemon_supervisor_source_file=${repo_root}/config/local-daemon-supervisor.ncl
trajectory_transcript_adapter_source_file=${repo_root}/config/trajectory-transcript-adapter.ncl
mcp_client_host_source_file=${repo_root}/config/mcp-client-host.ncl

if ! command -v nickel >/dev/null 2>&1; then
  printf '%s\n' 'error: nickel is required to export repo config. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

mkdir -p "${target_root}/.cargo"
mkdir -p "${target_root}/policy/recipe-workflows/generated"
mkdir -p "${target_root}/config/generated"

nickel export --format toml --field cargo_config "${source_file}" > "${target_root}/.cargo/config.toml"
nickel export --format toml --field clippy_config "${source_file}" > "${target_root}/clippy.toml"
nickel export --format toml --field dylint_config "${source_file}" > "${target_root}/dylint.toml"
nickel export --format yaml --field pre_commit_config "${source_file}" > "${target_root}/.pre-commit-config.yaml"
nickel export --format json --field agent_check_registry "${source_file}" > "${target_root}/config/generated/agent-check-registry.json"
nickel export --format json --field recipe_workflow_catalog "${recipe_source_file}" > "${target_root}/policy/recipe-workflows/generated/recipe-workflows.json"
nickel export --format json --field model_runtime_profile_set "${model_profile_source_file}" > "${target_root}/config/generated/model-runtime-profiles.json"
nickel export --format json --field agent_role_catalog "${agent_role_source_file}" > "${target_root}/config/generated/agent-role-profiles.json"
nickel export --format json --field aeneas_proof_campaign_bundle "${aeneas_proof_campaign_source_file}" > "${target_root}/config/generated/aeneas-proof-campaign.json"
nickel export --format json --field active_turn_recovery_policy "${active_turn_recovery_source_file}" > "${target_root}/config/generated/active-turn-recovery-policy.json"
nickel export --format json --field conversation_projection_policy "${conversation_projection_source_file}" > "${target_root}/config/generated/conversation-projection-policy.json"
nickel export --format json --field session_branch_explorer_policy "${session_branch_explorer_source_file}" > "${target_root}/config/generated/session-branch-explorer-policy.json"
nickel export --format json --field provider_retry_policy "${provider_retry_source_file}" > "${target_root}/config/generated/provider-retry-policy.json"
nickel export --format json --field session_tree_export_policy "${session_tree_export_source_file}" > "${target_root}/config/generated/session-tree-export-policy.json"
nickel export --format json --field durable_session_store_policy "${durable_session_store_source_file}" > "${target_root}/config/generated/durable-session-store-policy.json"
nickel export --format json --field session_authority_profile "${session_authority_profile_source_file}" > "${target_root}/config/generated/session-authority-profile.json"
nickel export --format json --field rlm_kernel_policy "${rlm_kernel_profile_source_file}" > "${target_root}/config/generated/rlm-kernel-profile.json"
nickel export --format json --field lean_loop_profile "${lean_loop_profile_source_file}" > "${target_root}/config/generated/lean-loop-profile.json"
nickel export --format json --field agent_guardrail_profile "${agent_guardrail_profile_source_file}" > "${target_root}/config/generated/agent-guardrail-profile.json"
