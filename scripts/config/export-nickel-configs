nickel export --format json --field basalt_authority_adapter "${basalt_authority_adapter_source_file}" > "${target_root}/config/generated/basalt-authority-adapter.json"
nickel export --format json --field pijul_vcs_adapter "${pijul_vcs_adapter_source_file}" > "${target_root}/config/generated/pijul-vcs-adapter.json"
nickel export --format json --field secret_resolution_policy "${secret_resolution_policy_source_file}" > "${target_root}/config/generated/secret-resolution-policy.json"
nickel export --format json "${skill_source_lifecycle_policy_source_file}" > "${target_root}/config/generated/skill-source-lifecycle-policy.json"
