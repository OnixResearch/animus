#!/usr/bin/env sh
set -eu

readonly FAILURE=1

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
default_repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)
repo_root=${ANIMUS_REPO_ROOT:-${default_repo_root}}
target_root=${1:-${repo_root}}
source_file=${repo_root}/config/repo.ncl
recipe_source_file=${repo_root}/config/recipe-workflows.ncl
model_profile_source_file=${repo_root}/config/model-runtime-profiles.ncl
agent_role_source_file=${repo_root}/config/agent-role-profiles.ncl
aeneas_proof_campaign_source_file=${repo_root}/config/aeneas-proof-campaign.ncl
active_turn_recovery_source_file=${repo_root}/config/active-turn-recovery-policy.ncl
conversation_projection_source_file=${repo_root}/config/conversation-projection-policy.ncl
session_branch_explorer_source_file=${repo_root}/config/session-branch-explorer-policy.ncl
provider_retry_source_file=${repo_root}/config/provider-retry-policy.ncl
session_tree_export_source_file=${repo_root}/config/session-tree-export-policy.ncl
durable_session_store_source_file=${repo_root}/config/durable-session-store-policy.ncl
session_authority_profile_source_file=${repo_root}/config/session-authority-profile.ncl
rlm_kernel_profile_source_file=${repo_root}/config/rlm-kernel-profile.ncl
lean_loop_profile_source_file=${repo_root}/config/lean-loop-profile.ncl
agent_guardrail_profile_source_file=${repo_root}/config/agent-guardrail-profile.ncl
codebase_graph_profile_source_file=${repo_root}/config/codebase-graph-profile.ncl
mesh_provider_profile_source_file=${repo_root}/config/mesh-provider-profile.ncl
spacewasm_profile_source_file=${repo_root}/config/spacewasm-embedded-compat.ncl
harbor_profile_source_file=${repo_root}/config/harbor-evaluation-profile.ncl
host_control_source_file=${repo_root}/config/host-control-source.ncl
autonomous_gates_policy_source_file=${repo_root}/config/autonomous-gates-policy.ncl
continual_harness_policy_source_file=${repo_root}/config/continual-harness-policy.ncl
daemon_workers_policy_source_file=${repo_root}/config/daemon-workers-policy.ncl
messaging_receipts_policy_source_file=${repo_root}/config/messaging-receipts-policy.ncl
persistent_goals_policy_source_file=${repo_root}/config/persistent-goals-policy.ncl
schedule_reliability_policy_source_file=${repo_root}/config/schedule-reliability-policy.ncl
session_event_replay_policy_source_file=${repo_root}/config/session-event-replay-policy.ncl
execution_backend_selection_policy_source_file=${repo_root}/config/execution-backend-selection-policy.ncl

if ! command -v nickel >/dev/null 2>&1; then
  printf '%s\n' 'error: nickel is required to export repo config. Run inside `nix develop`.' >&2
  exit "${FAILURE}"
fi

mkdir -p "${target_root}/.cargo"
mkdir -p "${target_root}/policy/recipe-workflows/generated"
mkdir -p "${target_root}/config/generated"

nickel export --format toml --field cargo_config "${source_file}" > "${target_root}/.cargo/config.toml"
nickel export --format toml --field clippy_config "${source_file}" > "${target_root}/clippy.toml"
nickel export --format toml --field dylint_config "${source_file}" > "${target_root}/dylint.toml"
nickel export --format yaml --field pre_commit_config "${source_file}" > "${target_root}/.pre-commit-config.yaml"
nickel export --format json --field agent_check_registry "${source_file}" > "${target_root}/config/generated/agent-check-registry.json"
nickel export --format json --field recipe_workflow_catalog "${recipe_source_file}" > "${target_root}/policy/recipe-workflows/generated/recipe-workflows.json"
nickel export --format json --field model_runtime_profile_set "${model_profile_source_file}" > "${target_root}/config/generated/model-runtime-profiles.json"
nickel export --format json --field agent_role_catalog "${agent_role_source_file}" > "${target_root}/config/generated/agent-role-profiles.json"
nickel export --format json --field aeneas_proof_campaign_bundle "${aeneas_proof_campaign_source_file}" > "${target_root}/config/generated/aeneas-proof-campaign.json"
nickel export --format json --field active_turn_recovery_policy "${active_turn_recovery_source_file}" > "${target_root}/config/generated/active-turn-recovery-policy.json"
nickel export --format json --field conversation_projection_policy "${conversation_projection_source_file}" > "${target_root}/config/generated/conversation-projection-policy.json"
nickel export --format json --field session_branch_explorer_policy "${session_branch_explorer_source_file}" > "${target_root}/config/generated/session-branch-explorer-policy.json"
nickel export --format json --field provider_retry_policy "${provider_retry_source_file}" > "${target_root}/config/generated/provider-retry-policy.json"
nickel export --format json --field session_tree_export_policy "${session_tree_export_source_file}" > "${target_root}/config/generated/session-tree-export-policy.json"
nickel export --format json --field durable_session_store_policy "${durable_session_store_source_file}" > "${target_root}/config/generated/durable-session-store-policy.json"
nickel export --format json --field session_authority_profile "${session_authority_profile_source_file}" > "${target_root}/config/generated/session-authority-profile.json"
nickel export --format json --field rlm_kernel_policy "${rlm_kernel_profile_source_file}" > "${target_root}/config/generated/rlm-kernel-profile.json"
nickel export --format json --field lean_loop_profile "${lean_loop_profile_source_file}" > "${target_root}/config/generated/lean-loop-profile.json"
nickel export --format json --field agent_guardrail_profile "${agent_guardrail_profile_source_file}" > "${target_root}/config/generated/agent-guardrail-profile.json"
nickel export --format json --field codebase_graph_profile "${codebase_graph_profile_source_file}" > "${target_root}/config/generated/codebase-graph-profile.json"
nickel export --format json --field mesh_provider_profile "${mesh_provider_profile_source_file}" > "${target_root}/config/generated/mesh-provider-profile.json"
nickel export --format json --field spacewasm_embedded_compat "${spacewasm_profile_source_file}" > "${target_root}/config/generated/spacewasm-embedded-compat.json"
nickel export --format json --field harbor_evaluation_profile "${harbor_profile_source_file}" > "${target_root}/config/generated/harbor-evaluation-profile.json"
nickel export --format json --field host_control_source "${host_control_source_file}" > "${target_root}/config/generated/host-control-source.json"
nickel export --format json --field autonomous_gates_policy "${autonomous_gates_policy_source_file}" > "${target_root}/config/generated/autonomous-gates-policy.json"
nickel export --format json --field continual_harness_policy "${continual_harness_policy_source_file}" > "${target_root}/config/generated/continual-harness-policy.json"
nickel export --format json --field daemon_workers_policy "${daemon_workers_policy_source_file}" > "${target_root}/config/generated/daemon-workers-policy.json"
nickel export --format json --field messaging_receipts_policy "${messaging_receipts_policy_source_file}" > "${target_root}/config/generated/messaging-receipts-policy.json"
nickel export --format json --field persistent_goals_policy "${persistent_goals_policy_source_file}" > "${target_root}/config/generated/persistent-goals-policy.json"
nickel export --format json --field schedule_reliability_policy "${schedule_reliability_policy_source_file}" > "${target_root}/config/generated/schedule-reliability-policy.json"
nickel export --format json --field session_event_replay_policy "${session_event_replay_policy_source_file}" > "${target_root}/config/generated/session-event-replay-policy.json"
nickel export --format json --field execution_backend_selection_policy "${execution_backend_selection_policy_source_file}" > "${target_root}/config/generated/execution-backend-selection-policy.json"
