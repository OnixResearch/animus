#!/usr/bin/env sh
set -eu

readonly FAILURE=1

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
default_repo_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)
repo_root=${ANIMUS_REPO_ROOT:-${default_repo_root}}
target_root=${1:-${repo_root}}
source_file=${repo_root}/config/repo.ncl
recipe_source_file=${repo_root}/config/recipe-workflows.ncl
model_profile_source_file=${repo_root}/config/model-runtime-profiles.ncl
agent_role_source_file=${repo_root}/config/agent-role-profiles.ncl
