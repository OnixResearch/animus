active_turn_recovery_source_file=${repo_root}/config/active-turn-recovery-policy.ncl
conversation_projection_source_file=${repo_root}/config/conversation-projection-policy.ncl
session_branch_explorer_source_file=${repo_root}/config/session-branch-explorer-policy.ncl
provider_retry_source_file=${repo_root}/config/provider-retry-policy.ncl
session_tree_export_source_file=${repo_root}/config/session-tree-export-policy.ncl
durable_session_store_source_file=${repo_root}/config/durable-session-store-policy.ncl
session_authority_profile_source_file=${repo_root}/config/session-authority-profile.ncl
rlm_kernel_profile_source_file=${repo_root}/config/rlm-kernel-profile.ncl
lean_loop_profile_source_file=${repo_root}/config/lean-loop-profile.ncl
agent_guardrail_profile_source_file=${repo_root}/config/agent-guardrail-profile.ncl
codebase_graph_profile_source_file=${repo_root}/config/codebase-graph-profile.ncl
